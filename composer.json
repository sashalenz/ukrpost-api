{
    "name": "sashalenz/ukrpost-api",
    "description": "Ukrposhta (eCom, Forms, StatusTracking, AddressClassifier) API SDK for Laravel",
    "keywords": ["ukrposhta", "ukrpost", "api", "laravel", "delivery"],
    "homepage": "https://github.com/sashalenz/ukrpost-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Sasha Lenz",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/config": "^11.0||^12.0||^13.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/http": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Sashalenz\\UkrPostApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sashalenz\\UkrPostApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sashalenz\\UkrPostApi\\UkrPostApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
